{
  "version": "2.0.0",
  "tasks": [
    // Build tasks
    {
      "label": "build-win-x64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ImageGlass.Win32/ImageGlass.Win32.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64",
        "-r",
        "win-x64",
        "--no-incremental"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-win-arm64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ImageGlass.Win32/ImageGlass.Win32.csproj",
        "-c",
        "Debug",
        "-p:Platform=ARM64",
        "-r",
        "win-arm64",
        "--no-incremental"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-linux-x64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ImageGlass.Linux/ImageGlass.Linux.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64",
        "-r",
        "linux-x64",
        "--no-incremental"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-mac-arm64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ImageGlass.Mac/ImageGlass.Mac.csproj",
        "-c",
        "Debug",
        "-p:Platform=ARM64",
        "-r",
        "osx-arm64",
        "--no-incremental"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },


    // Publish tasks
    {
      "label": "publish-win-x64",
      "type": "shell",
      "command": "dotnet publish '${workspaceFolder}/ImageGlass.Win32/ImageGlass.Win32.csproj' -c Release -r win-x64 -p:Platform=x64 -o '${workspaceFolder}/__artifacts/publish/win-x64'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Copy-Item -Path '${workspaceFolder}/__assets/__app/*' -Destination '${workspaceFolder}/__artifacts/publish/win-x64' -Recurse -Force",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-win-arm64",
      "type": "shell",
      "command": "dotnet publish '${workspaceFolder}/ImageGlass.Win32/ImageGlass.Win32.csproj' -c Release -r win-arm64 -p:Platform=ARM64 -o '${workspaceFolder}/__artifacts/publish/win-arm64'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Copy-Item -Path '${workspaceFolder}/__assets/__app/*' -Destination '${workspaceFolder}/__artifacts/publish/win-arm64' -Recurse -Force",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-linux-x64",
      "type": "shell",
      "command": "dotnet publish '${workspaceFolder}/ImageGlass.Linux/ImageGlass.Linux.csproj' -c Release -r linux-x64 -p:Platform=x64 -p:PublishAot=true -p:PublishSingleFile=true -p:PublishTrimmed=true -o '${workspaceFolder}/__artifacts/publish/linux-x64' --self-contained true && cp -r '${workspaceFolder}/__assets/__app/.' '${workspaceFolder}/__artifacts/publish/linux-x64/'",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-mac-arm64",
      "type": "shell",
      "command": "dotnet publish '${workspaceFolder}/ImageGlass.Mac/ImageGlass.Mac.csproj' -c Release -r osx-arm64 -p:Platform=ARM64 -p:PublishAot=true -p:PublishSingleFile=true -p:PublishTrimmed=true -o '${workspaceFolder}/__artifacts/publish/osx-arm64' --self-contained true && cp -r '${workspaceFolder}/__assets/__app/.' '${workspaceFolder}/__artifacts/publish/osx-arm64/'",
      "problemMatcher": "$msCompile",
      "group": "build"
    },


    // Pack tasks
    {
      "label": "pack-mac-arm64-app",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/__assets/mac/script-pack-mac-arm64-app.sh"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "publish-mac-arm64"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "pack-mac-arm64-dmg",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/__assets/mac/script-pack-mac-arm64-dmg.sh"
      ],
      "problemMatcher": [],
      "dependsOn": [
        "pack-mac-arm64-app"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "pack-linux-x64-flatpak",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/__assets/linux/script-pack-linux-x64-flatpak.sh"
      ],
      "options": {
        "env": {
          // Prompts on each run; leave blank to build an unsigned bundle.
          "GPG_KEY": "${input:gpgKey}"
        }
      },
      "problemMatcher": [],
      "group": "build"
    },
    // Linux AppImage pack task. Like the Flatpak one the script publishes a fresh AOT
    // build itself. Unlike Flatpak, an AppImage runs against the HOST glibc, so the
    // script prints the floor of the shipped binaries on every run.
    {
      "label": "pack-linux-x64-appimage",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/__assets/linux/script-pack-linux-x64-appimage.sh"
      ],
      "options": {
        "env": {
          // Prompts on each run; leave blank to build an unsigned AppImage.
          "GPG_KEY": "${input:gpgKey}"
        }
      },
      "problemMatcher": [],
      "group": "build"
    },

    // Windows MSIX pack tasks. The script publishes a fresh AOT build, so these
    // do NOT depend on the publish-win-* tasks.
    //
    //   Self-host (GitHub): a SIGNED .msix per architecture, logo-rendered artwork.
    //                       (built UNSIGNED if no signing certificate is found)
    //   Microsoft Store:    one UNSIGNED .msixbundle (x64 + arm64), Store artwork.
    {
      "label": "pack-win-x64-msix",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/__assets/win/script-pack-win-msix.ps1",
        "-Platform",
        "x64",
        "-Sign",
        "-UnvirtualizedResources"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "pack-win-arm64-msix",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/__assets/win/script-pack-win-msix.ps1",
        "-Platform",
        "arm64",
        "-Sign",
        "-UnvirtualizedResources"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "pack-win-msstore-msixbundle",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/__assets/win/script-pack-win-msix.ps1",
        "-Bundle"
      ],
      "problemMatcher": [],
      "group": "build"
    },

    // Windows portable ZIP pack tasks. Like the MSIX ones, the script publishes a fresh AOT
    // build itself. The archive ships the .igportable marker, so it keeps its settings in its
    // own folder; pass -NoPortable to build one that uses %LocalAppData% instead.
    {
      "label": "pack-win-x64-zip",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/__assets/win/script-pack-win-zip.ps1",
        "-Platform",
        "x64",
        "-Sign"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "pack-win-arm64-zip",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/__assets/win/script-pack-win-zip.ps1",
        "-Platform",
        "arm64",
        "-Sign"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    // Windows MSI installer pack task. Like the MSIX/ZIP ones the script publishes a fresh AOT
    // build itself, so it does NOT depend on the publish-win-* tasks.
    //
    //   x64 only. The package is dual-scope: the wizard asks per-user or per-machine, and both
    //   work under msiexec /qn. Installing it removes ImageGlass 9. Uninstalling cleans up the
    //   file-type registration unless IGREMOVEFILEASSOC=0.
    //
    // Needs the pinned WiX 5.0.2 dotnet tool + UI extension; the script fails with the exact
    // install commands if they are missing (or pass -BootstrapWix). See __assets/win/README.md.
    {
      "label": "pack-win-x64-msi",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/__assets/win/script-pack-win-msi.ps1",
        "-Platform",
        "x64",
        "-Sign"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    // Convenience: build everything for a release, the signed .msix + .msi installer +
    // portable .zip (self-host) and the .msixbundle (Microsoft Store).
    {
      "label": "pack-win-all",
      "dependsOn": [
        "pack-win-x64-msix",
        "pack-win-arm64-msix",
        "pack-win-msstore-msixbundle",
        "pack-win-x64-zip",
        "pack-win-arm64-zip",
        "pack-win-x64-msi"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "build"
    },
  ],
  "inputs": [
    {
      // Used by "pack-linux-x64-flatpak" and "pack-linux-x64-appimage". Not stored on
      // disk — VS Code only keeps the last value for the session. Blank => unsigned.
      "id": "gpgKey",
      "type": "promptString",
      "description": "GPG key (email or key ID) to sign the .flatpak bundle / .AppImage. Leave blank for an unsigned build.",
      "default": ""
    }
  ],
}