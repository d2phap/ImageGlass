<windows:SettingsPageView
    x:Class="ImageGlass.Common.Windows.MouseSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:ImageGlass.UI"
    xmlns:windows="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignWidth="600"
    HorizontalAlignment="Stretch">

    <StackPanel Orientation="Vertical">

        <!--  Mouse wheel action  -->
        <ui:PhTextBlock Classes="group" LangKey="Settings_MouseWheelAction" />
        <StackPanel Margin="{DynamicResource SettingsGroupIndent}" Spacing="14">
            <StackPanel x:Name="PART_WheelTable" Spacing="14" />

            <ui:PhButton
                x:Name="PART_ResetWheel"
                HorizontalAlignment="Left"
                Variant="Link" />
        </StackPanel>


        <!--  Mouse click action (Pro)  -->
        <ui:PhTextBlock Classes="group" LangKey="Settings_MouseClickAction" />
        <StackPanel Margin="{DynamicResource SettingsGroupIndent}" Spacing="14">
            <StackPanel x:Name="PART_ClickTable" Spacing="14" />

            <ui:PhButton
                x:Name="PART_ResetClick"
                HorizontalAlignment="Left"
                Variant="Link" />
        </StackPanel>

    </StackPanel>
</windows:SettingsPageView>
