<windows:SettingsPageView
    x:Class="ImageGlass.Common.Windows.AppearanceSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:types="using:ImageGlass.Common.Types"
    xmlns:ui="using:ImageGlass.UI"
    xmlns:windows="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignWidth="600"
    HorizontalAlignment="Stretch">

    <windows:SettingsPageView.Styles>
        <!--  Theme card: themed chrome (set here, not locally, so the hover override applies)  -->
        <Style Selector="Border.theme-card">
            <Setter Property="Background" Value="{DynamicResource IG_BackgroundNeutralBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IG_BorderControlBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!--  hover: accent border only (no background change)  -->
        <Style Selector="Border.theme-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PhAccentFillPointerOver}" />
        </Style>
    </windows:SettingsPageView.Styles>


    <StackPanel Orientation="Vertical">

        <!--  Appearance (no heading)  -->
        <StackPanel Margin="{DynamicResource SettingsGroupIndent}">

            <!--  Window backdrop (Windows 11 only)  -->
            <StackPanel x:Name="PART_BackdropSection" Spacing="{DynamicResource SettingsLabelInputGap}">
                <ui:PhTextBlock LangKey="Settings_WindowBackdrop" />
                <ComboBox
                    x:Name="PART_WindowBackdrop"
                    MinWidth="200"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <!--  Viewer background color  -->
            <StackPanel Margin="0,14,0,0" Spacing="{DynamicResource SettingsLabelInputGap}">
                <ui:PhTextBlock LangKey="_BackgroundColor" />
                <ui:PhColorPickerControl x:Name="PART_BgColor" HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>


        <!--  Theme  -->
        <ui:PhTextBlock Classes="group" LangKey="Settings_Theme" />
        <StackPanel x:Name="PART_ThemeGroup" Margin="{DynamicResource SettingsGroupIndent}">

            <!--  Theme actions  -->
            <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ui:PhButton
                    x:Name="PART_InstallTheme"
                    MinWidth="100"
                    HorizontalContentAlignment="Center"
                    Variant="Outline" />
                <ui:PhButton x:Name="PART_RefreshThemes" HorizontalContentAlignment="Center" />
                <ui:PhButton x:Name="PART_OpenThemeFolder" HorizontalContentAlignment="Center" />
                <ui:PhButton x:Name="PART_GetMoreThemes" Variant="Link" />
            </StackPanel>

            <!--  Overview: which packs are used for dark/light mode  -->
            <Border
                x:Name="PART_ThemeOverview"
                Width="{CompiledBinding #PART_ThemeGroup.Bounds.Width}"
                MaxWidth="1500"
                Margin="0,14,0,0"
                Padding="14,12"
                HorizontalAlignment="Left"
                Background="{DynamicResource IG_BackgroundNeutralBrush}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid ColumnDefinitions="*,Auto,*">
                    <!--  Dark mode  -->
                    <StackPanel Grid.Column="0" Spacing="3">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <PathIcon
                                Width="{x:Static types:Const.FONT_SIZE_SMALL}"
                                Height="{x:Static types:Const.FONT_SIZE_SMALL}"
                                Data="{StaticResource IconWeatherMoon}"
                                Opacity="0.8" />
                            <ui:PhTextBlock
                                FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                                LangKey="Settings_DarkTheme"
                                Opacity="0.8" />
                        </StackPanel>
                        <SelectableTextBlock
                            x:Name="PART_DarkThemeName"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  divider  -->
                    <Border
                        Grid.Column="1"
                        Width="1"
                        Margin="24,2"
                        Background="{DynamicResource IG_BorderControlBrush}" />

                    <!--  Light mode  -->
                    <StackPanel Grid.Column="2" Spacing="3">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <PathIcon
                                Width="{x:Static types:Const.FONT_SIZE_SMALL}"
                                Height="{x:Static types:Const.FONT_SIZE_SMALL}"
                                Data="{StaticResource IconWeatherSunny}"
                                Opacity="0.8" />
                            <ui:PhTextBlock
                                FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                                LangKey="Settings_LightTheme"
                                Opacity="0.8" />
                        </StackPanel>
                        <SelectableTextBlock
                            x:Name="PART_LightThemeName"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  empty state  -->
            <ui:PhTextBlock
                x:Name="PART_ThemeEmpty"
                Margin="0,12,0,0"
                FontStyle="Italic"
                IsVisible="False"
                LangKey="_Empty"
                Opacity="0.6" />

            <!--  theme cards (built in code-behind)  -->
            <StackPanel
                x:Name="PART_ThemeList"
                Width="{CompiledBinding #PART_ThemeGroup.Bounds.Width}"
                MaxWidth="1500"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Spacing="10" />

        </StackPanel>

    </StackPanel>

</windows:SettingsPageView>
